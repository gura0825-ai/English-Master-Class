# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env.local 은 커밋되지 않음)
# 값을 바꾼 뒤에는 npm run dev 를 껐다가 다시 켜야 반영됩니다.

# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버 전용(매일 메일 cron, 메일 평가 페이지). 절대 공개 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — resend.com > API Keys (Sending access)
RESEND_API_KEY=re_xxxxxxxxxxxx
# 도메인 인증 전에는 이 주소 그대로 두면 Resend 가입 이메일로만 보낼 수 있음
EMAIL_FROM="English Master Class <onboarding@resend.dev>"

# 아래 두 비밀값은 아무도 모르는 긴 임의 문자열로 각각 다르게 만든다. 만드는 법:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Vercel Cron 호출 인증 (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=change-me-long-random-string
# 메일 평가 링크(/r/[token]) 서명 키. 바꾸면 이미 보낸 메일의 링크는 무효가 됨
REVIEW_TOKEN_SECRET=change-me-another-long-random-string

# 메일 속 링크에 쓰는 앱 주소 (로컬: http://localhost:3000, 배포 후: https://…vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
