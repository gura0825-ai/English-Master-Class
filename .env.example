# 이 파일을 .env.local 로 복사한 뒤 실제 값을 채우세요. (.env.local 은 커밋되지 않음)

# Supabase — 프로젝트 설정 > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# 서버(cron)에서만 사용. 절대 클라이언트에 노출 금지
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Resend — 메일 발송
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="English Master Class <onboarding@resend.dev>"

# Vercel Cron 호출 인증 (Authorization: Bearer ${CRON_SECRET})
CRON_SECRET=change-me-long-random-string
# 메일 평가 링크(/r/[token]) HMAC 서명 키
REVIEW_TOKEN_SECRET=change-me-another-long-random-string

# 앱 주소 (로컬: http://localhost:3000, 배포 후: https://…vercel.app)
NEXT_PUBLIC_APP_URL=http://localhost:3000
